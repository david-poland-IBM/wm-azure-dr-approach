<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio">
  <diagram name="Architecture">
    <mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="&lt;b&gt;Unplanned failover — order of steps&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#111111;text;fillColor=#ffffff;strokeColor=none;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="0" width="1010" height="35" />
        </mxCell>
        <mxCell id="c3" value="1. Declare DR&lt;br&gt;Freeze CI/CD; keep primary UM stopped" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#111111;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="60" width="180" height="85" />
        </mxCell>
        <mxCell id="c4" value="2. Azure SQL&lt;br&gt;Forced failover" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#111111;rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="230" y="60" width="180" height="85" />
        </mxCell>
        <mxCell id="c5" value="3. Break ANF replication&lt;br&gt;DR volume read-write" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#111111;rounded=0;fillColor=#fff8e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="60" width="180" height="85" />
        </mxCell>
        <mxCell id="c6" value="4. Scale DR&lt;br&gt;AKS user pool" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#111111;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="60" width="180" height="85" />
        </mxCell>
        <mxCell id="c7" value="5. Start UM (um-0)&lt;br&gt;Bind static PVC&lt;br&gt;um-data-um-0" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#111111;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="60" width="180" height="85" />
        </mxCell>
        <mxCell id="c8" value="6. Start IS, then MWS&lt;br&gt;Same UM pod DNS name; DR Key Vault" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#111111;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="210" width="180" height="85" />
        </mxCell>
        <mxCell id="c9" value="7. Smoke tests&lt;br&gt;IS → UM pub/sub; MWS" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#111111;rounded=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="210" width="180" height="85" />
        </mxCell>
        <mxCell id="c10" value="8. Switch Front Door&lt;br&gt;IS/MWS HTTPS only" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#111111;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="210" width="180" height="85" />
        </mxCell>
        <mxCell id="c11" value="9. Record data loss&lt;br&gt;Notify stakeholders" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#111111;rounded=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;rounded=1;" vertex="1" parent="1">
