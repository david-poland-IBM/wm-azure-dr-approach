        <mxCell id="c20" value="IS reaches UM at nsp://um-0.um.&amp;lt;namespace&amp;gt;.svc.cluster.local:9000 in both regions (headless Service), so IS needs no configuration change in DR." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#111111;text;fillColor=#ffffff;strokeColor=none;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="330" width="1020" height="40" />
        </mxCell>
        <mxCell id="c21" value="&lt;b&gt;Failback (planned, lossless):&lt;/b&gt; repair primary → reverse SQL replication and ANF reverse resync → wait for catch-up → stop DR UM, planned switchback in a maintenance window → validate IS → um-0 and IS/MWS HTTPS → return DR to standby." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#111111;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;verticalAlign=middle;" vertex="1" parent="1">
